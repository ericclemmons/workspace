#!/usr/bin/env bash
# Blocks structurally wrong commits in the meta repo.
# Run by hk via hk.pkl.
set -euo pipefail

# Allow privileged ops for tests.
[[ "${META_ALLOW_COMMIT:-}" == "1" ]] && exit 0

# The public workspace repo must never commit task checkout contents.
if git diff --cached --name-only | grep -qE '^\.worktrees/'; then
  cat >&2 <<EOF
✗ Workspace commits cannot include .worktrees/.

.worktrees/ contains per-task workspace checkouts.
Only commit subtree snapshots, workspace tooling, docs, hooks, and config in this repo.
EOF
  exit 1
fi

exit 0
