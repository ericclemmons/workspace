#!/usr/bin/env bash
#MISE description="List configured base repos and task worktrees. Usage: list"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_workspace_root
root=$(workspace_root)

echo "repos"
repos=()
while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
if [[ ${#repos[@]} -eq 0 ]]; then
  echo "  (none)"
else
  for repo in "${repos[@]}"; do
    url=$(git -C "$root/repos/$repo" remote get-url origin 2>/dev/null || echo "no origin")
    branch=$(repo_default_branch "$root/repos/$repo")
    prefix=$(repo_prefix "$repo")
    echo "  $repo  $url  default=$branch  prefix=$prefix"
  done
fi

echo
echo "worktrees"
if [[ ! -d "$root/worktrees" ]]; then
  echo "  (none)"
  exit 0
fi

found=0
for task in "$root"/worktrees/*; do
  [[ -d "$task" ]] || continue
  found=1
  echo "  $(basename "$task")"
  [[ -f "$task/.git" || -d "$task/.git" ]] || { echo "    (not a workspace git worktree)"; continue; }
  task_has_repo=0
  while IFS= read -r repo; do
    prefix=$(repo_prefix "$repo")
    [[ -e "$task/$prefix" ]] || continue
    task_has_repo=1
    branch=$(git -C "$task" symbolic-ref --short HEAD 2>/dev/null || echo "detached")
    echo "    $repo  prefix=$prefix  branch=$branch"
  done < <(list_repos)
  [[ $task_has_repo -eq 1 ]] || echo "    (no repo prefixes)"
done
[[ $found -eq 1 ]] || echo "  (none)"
