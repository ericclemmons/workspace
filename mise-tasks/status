#!/usr/bin/env bash
#MISE description="Show workspace or task repo status. Usage: status [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

if task=$(task_root 2>/dev/null); then
  workspace=$task
  scope=".worktrees/$(basename "$task")"
  repos=("$@")
  if [[ ${#repos[@]} -eq 0 ]]; then
    repos=()
    while IFS= read -r repo; do repos+=("$repo"); done < <(list_task_repos)
  fi
else
  require_workspace_root
  workspace=$(workspace_root)
  scope="workspace"
  repos=("$@")
  if [[ ${#repos[@]} -eq 0 ]]; then
    repos=()
    while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
  fi
  info "workspace"
  git status --short --branch
fi

[[ ${#repos[@]} -gt 0 ]] || { warn "no repos found in $scope"; exit 0; }

for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"
  echo
  prefix=$(repo_prefix "$repo")
  [[ -e "$workspace/$prefix" ]] || die "$scope is missing prefix $prefix for $repo"
  info "$scope/$repo ($prefix)"
  if [[ "$scope" == .worktrees/* ]]; then
    git -C "$workspace" diff --stat main..HEAD -- "$prefix"
    git -C "$workspace" status --short -- "$prefix"
  else
    git -C "$workspace" status --short -- "$prefix"
  fi
done
