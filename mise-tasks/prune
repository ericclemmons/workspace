#!/usr/bin/env bash
#MISE description="Prune merged local branches and their worktrees."
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

worktree_for_branch() {
  local branch=$1 path="" line
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) path=${line#worktree } ;;
      "branch refs/heads/$branch") echo "$path"; return 0 ;;
      "") path="" ;;
    esac
  done < <(git worktree list --porcelain)
}

require_main_checkout
cd "$(meta_root)"

current=$(git symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD"
[[ "$current" == "main" ]] || die "run this from main"

info "fetching and pruning remotes"
git fetch --prune

pruned=0
while IFS='|' read -r branch upstream_state; do
  [[ "$branch" != "main" ]] || continue

  if ! git merge-base --is-ancestor "$branch" main; then
    [[ "$upstream_state" == "[gone]" ]] \
      && warn "skipping $branch — upstream is gone, but branch is not merged into main"
    continue
  fi

  wt=$(worktree_for_branch "$branch")
  if [[ -n "$wt" ]]; then
    info "removing worktree $wt"
    git worktree remove "$wt" || die "failed to remove worktree for $branch"
  fi

  info "deleting branch $branch"
  git branch -d "$branch"
  pruned=$((pruned + 1))
done < <(git for-each-ref --format='%(refname:short)|%(upstream:track)' refs/heads)

[[ $pruned -gt 0 ]] || { warn "nothing to prune"; exit 0; }
ok "pruned $pruned branch(es)"
