#!/usr/bin/env bash
# Internal helper for `mise bootstrap`. Not shown in `mise tasks`.
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

root=$(workspace_root)
cd "$root"

if [[ ! -d .git ]]; then
  info "initializing local workspace git repo"
  git init -b main
fi

mkdir -p repos worktrees
git config --local include.path ../.gitconfig

if [[ -d .githooks ]]; then
  git config --local core.hooksPath .githooks
fi

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  ok "workspace git repo already initialized"
  exit 0
fi

if ! git config user.email >/dev/null || ! git config user.name >/dev/null; then
  warn "git user.name/user.email are not configured; set them before the initial commit"
  warn "example: git config user.name 'Your Name' && git config user.email you@example.com"
  exit 1
fi

info "creating initial local workspace commit"
git add .
git commit -m "Initialize workspace"
ok "workspace initialized"
