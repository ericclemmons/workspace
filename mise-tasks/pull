#!/usr/bin/env bash
#MISE description="Fast-forward workspace and base repos. Usage: pull [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_workspace_root
root=$(workspace_root)

git diff --quiet && git diff --cached --quiet \
  || die "workspace has uncommitted changes — commit or stash first"

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  info "pulling workspace"
  git pull --ff-only
else
  warn "skipping workspace pull — main has no upstream"
fi

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
  repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
fi

if [[ ${#repos[@]} -eq 0 ]]; then
  warn "no repos configured"
  ok "done"
  exit 0
fi

base_paths=()
defaults=()
for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"
  base="$root/repos/$repo"
  [[ -d "$base/.git" || -f "$base/.git" ]] || die "repos/$repo is not a git repo"
  repo_clean "$base" || die "repos/$repo has uncommitted changes; base repos must stay clean"

  default=$(repo_default_branch "$base")
  base_paths+=("$base")
  defaults+=("$default")
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

pull_repo() {
  local repo=$1 base=$2 default=$3
  info "pulling $repo ($default)"
  git -C "$base" fetch --prune origin
  git -C "$base" switch -q "$default"
  git -C "$base" pull --ff-only origin "$default"
  ok "pulled $repo"
}

branch_was_pushed() {
  local wt=$1 branch=$2
  git -C "$wt" config --get "branch.$branch.remote" >/dev/null 2>&1 \
    || git -C "$wt" show-ref --verify --quiet "refs/remotes/origin/$branch"
}

task_repo_merged() {
  local wt=$1 base=$2 branch default target
  repo_clean "$wt" || return 1
  branch=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null) || return 1
  branch_was_pushed "$wt" "$branch" || return 1
  default=$(repo_default_branch "$base")
  target="refs/remotes/origin/$default"
  git -C "$base" show-ref --verify --quiet "$target" || return 1
  git -C "$wt" merge-base --is-ancestor HEAD "$target"
}

cleanup_merged_tasks() {
  local task repo name base found can_clean
  [[ -d "$root/worktrees" ]] || return 0

  for task in "$root"/worktrees/*; do
    [[ -d "$task" ]] || continue
    [[ -d "$task/.git" || -f "$task/.git" ]] && continue

    found=0
    can_clean=1
    for repo in "$task"/*; do
      [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
      found=1
      name=$(basename "$repo")
      base="$root/repos/$name"
      [[ -d "$base/.git" || -f "$base/.git" ]] || { can_clean=0; break; }
      task_repo_merged "$repo" "$base" || { can_clean=0; break; }
    done

    [[ $found -eq 1 && $can_clean -eq 1 ]] || continue
    for repo in "$task"/*; do
      [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
      name=$(basename "$repo")
      info "removing merged worktree $(basename "$task")/$name"
      git -C "$root/repos/$name" worktree remove "$repo"
    done
    rmdir "$task" 2>/dev/null || warn "worktrees/$(basename "$task") is not empty; left it in place"
  done
}

pids=()
outputs=()
for i in "${!repos[@]}"; do
  repo=${repos[$i]}
  out="$tmp/$repo.out"
  pull_repo "$repo" "${base_paths[$i]}" "${defaults[$i]}" >"$out" 2>&1 &
  pids+=("$!")
  outputs+=("$out")
done

failed=0
for i in "${!pids[@]}"; do
  if wait "${pids[$i]}"; then
    cat "${outputs[$i]}"
  else
    rc=$?
    cat "${outputs[$i]}" >&2
    warn "${repos[$i]} failed with exit $rc"
    failed=1
  fi
done

[[ $failed -eq 0 ]] || die "one or more repos failed to pull"

cleanup_merged_tasks

ok "done"
