#!/usr/bin/env bash
#MISE description="Pull workspace config, base repos, and default subtree prefixes. Usage: pull [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_workspace_root
root=$(workspace_root)

workspace_clean "$root" || die "workspace has uncommitted changes — commit or stash first"

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  info "pulling workspace"
  git pull --ff-only
else
  warn "skipping workspace config pull — current branch has no upstream"
fi

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
  repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
fi

if [[ ${#repos[@]} -eq 0 ]]; then
  warn "no repos configured"
  ok "done"
  exit 0
fi

base_paths=()
defaults=()
for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"
  base="$root/repos/$repo"
  [[ -d "$base/.git" || -f "$base/.git" ]] || die "repos/$repo is not a git repo"
  repo_clean "$base" || die "repos/$repo has uncommitted changes; base repos must stay clean"

  default=$(repo_default_branch "$base")
  base_paths+=("$base")
  defaults+=("$default")
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

pull_repo() {
  local repo=$1 base=$2 default=$3
  info "pulling base repo $repo ($default)"
  git -C "$base" fetch --prune origin
  git -C "$base" switch -q "$default"
  git -C "$base" pull --ff-only origin "$default"
  ok "pulled base repo $repo"
}

cleanup_merged_tasks() {
  local task branch repo base default split remote found_branch can_clean
  [[ -d "$root/worktrees" ]] || return 0

  for task in "$root"/worktrees/*; do
    [[ -d "$task" ]] || continue
    [[ -d "$task/.git" || -f "$task/.git" ]] || continue
    workspace_clean "$task" || continue
    branch=$(basename "$task")

    found_branch=0
    can_clean=1
    while IFS= read -r repo; do
      [[ -e "$task/$(repo_prefix "$repo")" ]] || continue
      base="$root/repos/$repo"
      [[ -d "$base/.git" || -f "$base/.git" ]] || { can_clean=0; break; }

      if git -C "$base" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        found_branch=1
        default=$(repo_default_branch "$base")
        split=$(git -C "$task" subtree split --prefix "$(repo_prefix "$repo")" HEAD)
        remote=$(cd "$task" && ensure_workspace_remote "$repo")
        git -C "$task" fetch "$remote" "$default"
        git -C "$task" merge-base --is-ancestor "$split" "$remote/$default" || { can_clean=0; break; }
      elif ! git -C "$task" diff --quiet main..HEAD -- "$(repo_prefix "$repo")"; then
        can_clean=0
        break
      fi
    done < <(list_repos)

    if [[ $found_branch -eq 0 ]]; then
      git -C "$task" diff --quiet main..HEAD || can_clean=0
    fi

    [[ $can_clean -eq 1 ]] || continue
    info "removing merged workspace worktree $branch"
    git -C "$root" worktree remove "$task"
  done
}

pids=()
outputs=()
for i in "${!repos[@]}"; do
  repo=${repos[$i]}
  out="$tmp/$repo.out"
  pull_repo "$repo" "${base_paths[$i]}" "${defaults[$i]}" >"$out" 2>&1 &
  pids+=("$!")
  outputs+=("$out")
done

failed=0
for i in "${!pids[@]}"; do
  if wait "${pids[$i]}"; then
    cat "${outputs[$i]}"
  else
    rc=$?
    cat "${outputs[$i]}" >&2
    warn "${repos[$i]} failed with exit $rc"
    failed=1
  fi
done

current=$(workspace_branch)
[[ "$current" == "main" ]] || die "pull subtree updates from main; current branch is $current"

[[ $failed -eq 0 ]] || die "one or more repos failed to pull"

for i in "${!repos[@]}"; do
  repo=${repos[$i]}
  default=${defaults[$i]}
  prefix=$(repo_prefix "$repo")
  remote=$(ensure_workspace_remote "$repo")
  if [[ -e "$prefix" ]]; then
    info "pulling subtree $repo into $prefix ($default)"
    git fetch "$remote" "$default"
    git subtree pull --prefix "$prefix" "$remote" "$default"
  else
    ensure_subtree_on_current_branch "$repo"
  fi
done

cleanup_merged_tasks

ok "done"
