#!/usr/bin/env bash
#MISE description="Pull workspace config and default subtree prefixes. Usage: pull [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_workspace_root
root=$(workspace_root)

workspace_clean "$root" || die "workspace has uncommitted changes — commit or stash first"

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  info "pulling workspace"
  git pull -q --ff-only
else
  warn "skipping workspace config pull — current branch has no upstream"
fi

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
  repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
fi

if [[ ${#repos[@]} -eq 0 ]]; then
  warn "no repos configured"
  ok "done"
  exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fetch_repo() {
  local repo=$1 remote default
  remote=$(ensure_workspace_remote "$repo")
  default=$(repo_default_branch "$repo")
  info "fetching $repo ($default)"
  git fetch -q --prune "$remote" "$default"
  ok "fetched $repo"
}

pids=()
outputs=()
for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"
  out="$tmp/$repo.out"
  fetch_repo "$repo" >"$out" 2>&1 &
  pids+=("$!")
  outputs+=("$out")
done

failed=0
for i in "${!pids[@]}"; do
  if wait "${pids[$i]}"; then
    cat "${outputs[$i]}"
  else
    rc=$?
    cat "${outputs[$i]}" >&2
    warn "${repos[$i]} failed with exit $rc"
    failed=1
  fi
done

current=$(workspace_branch)
[[ "$current" == "main" ]] || die "pull subtree updates from main; current branch is $current"

[[ $failed -eq 0 ]] || die "one or more repos failed to fetch"

for repo in "${repos[@]}"; do
  default=$(repo_default_branch "$repo")
  prefix=$(repo_prefix "$repo")
  remote=$(ensure_workspace_remote "$repo")
  if [[ -e "$prefix" ]]; then
    info "updating subtree $repo in $prefix ($default)"
    git fetch -q "$remote" "$default"
    current_tree=$(git rev-parse -q --verify "HEAD:$prefix" 2>/dev/null || true)
    upstream_tree=$(git rev-parse "$remote/$default^{tree}")
    if [[ "$current_tree" == "$upstream_tree" ]]; then
      ok "$repo already up to date"
      continue
    fi

    old_head=$(git rev-parse HEAD)
    upstream_sha=$(git rev-parse "$remote/$default")
    git rm -qr -- "$prefix"
    git read-tree --prefix="$prefix/" -u "$remote/$default"
    short=$(git rev-parse --short "$remote/$default")
    git commit -q \
      -m "Update $repo to $short" \
      -m "git-subtree-dir: $prefix
git-subtree-mainline: $old_head
git-subtree-split: $upstream_sha"
  else
    ensure_subtree_on_current_branch "$repo"
  fi
done

ok "done"
