#!/usr/bin/env bash
# Sourced by other tasks. Not a runnable task (prefixed with _ to hide from `mise tasks`).
set -euo pipefail

if [[ -t 1 ]]; then
  C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_GREEN=""; C_RED=""; C_YELLOW=""; C_BLUE=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

info() { echo "${C_BLUE}->${C_RESET} $*"; }
ok()   { echo "${C_GREEN}✓${C_RESET} $*"; }
warn() { echo "${C_YELLOW}!${C_RESET} $*" >&2; }
die()  { echo "${C_RED}✗${C_RESET} $*" >&2; exit 1; }

TASK_DIR=$(cd "${MISE_TASK_DIR:-$(dirname "${BASH_SOURCE[0]}")}" && pwd -P)

workspace_root() {
  dirname "$TASK_DIR"
}

require_workspace_root() {
  local root cwd
  root=$(workspace_root)
  cwd=$(pwd -P)
  [[ "$cwd" == "$root" ]] || die "run this from the workspace root: $root"
}

validate_name() {
  local kind=$1 name=$2
  [[ -n "$name" ]] || die "missing $kind name"
  [[ "$name" =~ ^[a-zA-Z0-9_.-]+$ ]] || die "invalid $kind name: '$name'"
  [[ "$name" != "." && "$name" != ".." ]] || die "invalid $kind name: '$name'"
}

repo_remote() {
  local repo=$1
  echo "workspace-$repo"
}

list_repos() {
  local remote
  git remote 2>/dev/null | while IFS= read -r remote; do
    [[ "$remote" == workspace-* ]] || continue
    printf '%s\n' "${remote#workspace-}"
  done | sort
}

repo_prefix() {
  local repo=$1 remote configured
  remote=$(repo_remote "$repo")
  configured=$(git config --get "remote.$remote.workspacePrefix" 2>/dev/null || true)
  if [[ -n "$configured" ]]; then
    echo "$configured"
  else
    echo "$repo"
  fi
}

repo_origin_url() {
  local repo=$1 remote
  remote=$(repo_remote "$repo")
  git remote get-url "$remote"
}

remote_default_branch() {
  local url=$1 kind ref head
  while read -r kind ref head; do
    if [[ "$kind" == "ref:" && "$head" == "HEAD" ]]; then
      echo "${ref#refs/heads/}"
      return 0
    fi
  done < <(git ls-remote --symref "$url" HEAD 2>/dev/null || true)
  echo "main"
}

repo_default_branch() {
  local repo=$1 remote configured url
  remote=$(repo_remote "$repo")
  configured=$(git config --get "remote.$remote.workspaceDefaultBranch" 2>/dev/null || true)
  [[ -n "$configured" ]] && { echo "$configured"; return 0; }

  url=$(repo_origin_url "$repo" 2>/dev/null || true)
  if [[ -n "$url" ]]; then
    remote_default_branch "$url"
  else
    echo "main"
  fi
}

workspace_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED"
}

task_root() {
  local root cwd rel task
  root=$(workspace_root)
  cwd=$(pwd -P)
  case "$cwd" in
    "$root"/.worktrees/*)
      rel=${cwd#"$root"/.worktrees/}
      task=${rel%%/*}
      echo "$root/.worktrees/$task"
      ;;
    *) return 1 ;;
  esac
}

task_name() {
  basename "$(task_root)"
}

require_task_root() {
  local root cwd task
  task=$(task_root) || die "run this from inside .worktrees/<task>"
  cwd=$(pwd -P)
  [[ "$cwd" == "$task" ]] || die "run this from the task root: $task"
  root=$(workspace_root)
  [[ "$task" == "$root"/.worktrees/* ]] || die "not inside a workspace task"
  [[ -d "$task/.git" || -f "$task/.git" ]] || die ".worktrees/$(basename "$task") is not a workspace git worktree"
}

list_task_repos() {
  local task repo prefix
  task=$(task_root) || return 0
  while IFS= read -r repo; do
    prefix=$(repo_prefix "$repo")
    [[ -e "$task/$prefix" ]] || continue
    printf '%s\n' "$repo"
  done < <(list_repos) | sort
}

workspace_clean() {
  local dir=${1:-.}
  git -C "$dir" diff --quiet && git -C "$dir" diff --cached --quiet
}

ensure_workspace_remote() {
  local repo=$1 remote url
  remote=$(repo_remote "$repo")
  url=$(git remote get-url "$remote" 2>/dev/null || true)
  [[ -n "$url" ]] || die "repo '$repo' is not configured; add it with: mise run add $repo <url> [prefix]"
  echo "$remote"
}

ensure_subtree_on_current_branch() {
  local repo=$1 prefix default remote
  prefix=$(repo_prefix "$repo")
  default=$(repo_default_branch "$repo")
  remote=$(ensure_workspace_remote "$repo")

  if [[ -e "$prefix" ]]; then
    return 0
  fi

  info "adding subtree $repo at $prefix from $default"
  git fetch "$remote" "$default"
  git subtree add --prefix "$prefix" "$remote/$default"
}
