#!/usr/bin/env bash
# Sourced by other tasks. Not a runnable task (prefixed with _ to hide from `mise tasks`).
set -euo pipefail

if [[ -t 1 ]]; then
  C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_GREEN=""; C_RED=""; C_YELLOW=""; C_BLUE=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

info() { echo "${C_BLUE}→${C_RESET} $*"; }
ok()   { echo "${C_GREEN}✓${C_RESET} $*"; }
warn() { echo "${C_YELLOW}!${C_RESET} $*" >&2; }
die()  { echo "${C_RED}✗${C_RESET} $*" >&2; exit 1; }

TASK_DIR=$(cd "${MISE_TASK_DIR:-$(dirname "${BASH_SOURCE[0]}")}" && pwd -P)

workspace_root() {
  dirname "$TASK_DIR"
}

require_workspace_root() {
  local root cwd
  root=$(workspace_root)
  cwd=$(pwd -P)
  [[ "$cwd" == "$root" ]] || die "run this from the workspace root: $root"
}

validate_name() {
  local kind=$1 name=$2
  [[ -n "$name" ]] || die "missing $kind name"
  [[ "$name" =~ ^[a-zA-Z0-9_.-]+$ ]] || die "invalid $kind name: '$name'"
  [[ "$name" != "." && "$name" != ".." ]] || die "invalid $kind name: '$name'"
}

list_repos() {
  local root name
  root=$(workspace_root)
  [[ -d "$root/repos" ]] || return 0
  for path in "$root"/repos/*; do
    [[ -d "$path/.git" || -f "$path/.git" ]] || continue
    name=$(basename "$path")
    printf '%s\n' "$name"
  done | sort
}

repo_path() {
  local repo=$1
  echo "$(workspace_root)/repos/$repo"
}

repo_default_branch() {
  local repo=$1 configured ref
  configured=$(git -C "$repo" config --get workspace.defaultBranch 2>/dev/null || true)
  [[ -n "$configured" ]] && { echo "$configured"; return 0; }

  ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [[ -n "$ref" ]]; then
    echo "${ref#origin/}"
  else
    echo "main"
  fi
}

repo_prefix() {
  local repo=$1 base configured
  base=$(repo_path "$repo")
  configured=$(git -C "$base" config --get workspace.prefix 2>/dev/null || true)
  if [[ -n "$configured" ]]; then
    echo "$configured"
  else
    echo "$repo"
  fi
}

repo_origin_url() {
  local repo=$1 base
  base=$(repo_path "$repo")
  git -C "$base" remote get-url origin
}

workspace_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED"
}

task_root() {
  local root cwd rel task
  root=$(workspace_root)
  cwd=$(pwd -P)
  case "$cwd" in
    "$root"/worktrees/*)
      rel=${cwd#"$root"/worktrees/}
      task=${rel%%/*}
      echo "$root/worktrees/$task"
      ;;
    *) return 1 ;;
  esac
}

task_name() {
  basename "$(task_root)"
}

require_task_root() {
  local root cwd task
  task=$(task_root) || die "run this from inside worktrees/<task>"
  cwd=$(pwd -P)
  [[ "$cwd" == "$task" ]] || die "run this from the task root: $task"
  root=$(workspace_root)
  [[ "$task" == "$root"/worktrees/* ]] || die "not inside a workspace task"
  [[ -d "$task/.git" || -f "$task/.git" ]] || die "worktrees/$(basename "$task") is not a workspace git worktree"
}

list_task_repos() {
  local task repo prefix
  task=$(task_root) || return 0
  while IFS= read -r repo; do
    prefix=$(repo_prefix "$repo")
    [[ -e "$task/$prefix" ]] || continue
    printf '%s\n' "$repo"
  done < <(list_repos) | sort
}

repo_clean() {
  local repo=$1
  git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet
}

workspace_clean() {
  local dir=${1:-.}
  git -C "$dir" diff --quiet && git -C "$dir" diff --cached --quiet
}

ensure_workspace_remote() {
  local repo=$1 url remote current
  url=$(repo_origin_url "$repo")
  remote="workspace-$repo"
  if git remote get-url "$remote" >/dev/null 2>&1; then
    current=$(git remote get-url "$remote")
    [[ "$current" == "$url" ]] || git remote set-url "$remote" "$url"
  else
    git remote add "$remote" "$url"
  fi
  echo "$remote"
}

ensure_subtree_on_current_branch() {
  local repo=$1 base prefix default remote
  base=$(repo_path "$repo")
  prefix=$(repo_prefix "$repo")
  default=$(repo_default_branch "$base")
  remote=$(ensure_workspace_remote "$repo")

  [[ -d "$base/.git" || -f "$base/.git" ]] || die "repos/$repo is not a git repo"
  if [[ -e "$prefix" ]]; then
    return 0
  fi

  info "adding subtree $repo at $prefix from $default"
  git fetch "$remote" "$default"
  git subtree add --prefix "$prefix" "$remote/$default"
}
