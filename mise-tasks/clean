#!/usr/bin/env bash
#MISE description="Clean workspace task worktrees and stale Git state. Usage: clean [task|--merged|--prune]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_workspace_root
root=$(workspace_root)

clean_task() {
  local task_name_arg=$1 task
  validate_name "task" "$task_name_arg"
  task="$root/.worktrees/$task_name_arg"
  [[ -d "$task" ]] || die ".worktrees/$task_name_arg does not exist"
  [[ -d "$task/.git" || -f "$task/.git" ]] || die ".worktrees/$task_name_arg is not a workspace git worktree"
  workspace_clean "$task" || die ".worktrees/$task_name_arg has uncommitted changes; commit or discard them first"

  info "removing .worktrees/$task_name_arg"
  git -C "$root" worktree remove "$task"
  ok "cleaned .worktrees/$task_name_arg"
}

prune_git_state() {
  local repo remote
  info "pruning Git worktree metadata"
  git -C "$root" worktree prune

  while IFS= read -r repo; do
    remote=$(repo_remote "$repo")
    info "pruning $remote"
    git -C "$root" remote prune "$remote"
  done < <(list_repos)
  ok "pruned stale Git state"
}

clean_merged_tasks() {
  local task branch repo default prefix remote found_branch can_clean
  [[ -d "$root/.worktrees" ]] || return 0

  for task in "$root"/.worktrees/*; do
    [[ -d "$task" ]] || continue
    [[ -d "$task/.git" || -f "$task/.git" ]] || continue
    if ! git -C "$task" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      warn "skipping broken workspace worktree $(basename "$task")"
      continue
    fi
    workspace_clean "$task" || continue
    branch=$(basename "$task")

    found_branch=0
    can_clean=1
    while IFS= read -r repo; do
      prefix=$(repo_prefix "$repo")
      [[ -e "$task/$prefix" ]] || continue
      remote=$(cd "$task" && ensure_workspace_remote "$repo")

      if git -C "$task" ls-remote --heads "$remote" "$branch" | grep -q .; then
        found_branch=1
        default=$(repo_default_branch "$repo")
        git -C "$task" fetch -q "$remote" "$default" "$branch"
        git -C "$task" merge-base --is-ancestor "$remote/$branch" "$remote/$default" || { can_clean=0; break; }
      elif ! git -C "$task" diff --quiet main..HEAD -- "$prefix"; then
        can_clean=0
        break
      fi
    done < <(list_repos)

    if [[ $found_branch -eq 0 ]]; then
      git -C "$task" diff --quiet main..HEAD || can_clean=0
    fi

    [[ $can_clean -eq 1 ]] || continue
    info "removing merged workspace worktree $branch"
    git -C "$root" worktree remove "$task"
  done
}

case "${1:-}" in
  "")
    prune_git_state
    clean_merged_tasks
    ok "done"
    ;;
  --merged)
    [[ $# -eq 1 ]] || die "usage: mise run clean [task|--merged|--prune]"
    clean_merged_tasks
    ok "done"
    ;;
  --prune)
    [[ $# -eq 1 ]] || die "usage: mise run clean [task|--merged|--prune]"
    prune_git_state
    ;;
  --*)
    die "usage: mise run clean [task|--merged|--prune]"
    ;;
  *)
    [[ $# -eq 1 ]] || die "usage: mise run clean [task|--merged|--prune]"
    clean_task "$1"
    ;;
esac
