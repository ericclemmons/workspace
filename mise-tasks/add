#!/usr/bin/env bash
#MISE description="Clone an upstream repo into repos/<name> and add its subtree. Usage: add <name> <url> [prefix]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

name=${1:-}
url=${2:-}
prefix=${3:-}

[[ -z "$name" || -z "$url" || $# -gt 3 ]] && die "usage: mise run add <name> <url> [prefix]"
validate_name "repo" "$name"
require_workspace_root

root=$(workspace_root)
mkdir -p "$root/repos"
dest="$root/repos/$name"
[[ -n "$prefix" ]] || prefix="$name"
[[ "$prefix" != /* && "$prefix" != *..* && "$prefix" != "." ]] || die "invalid prefix: '$prefix'"

if [[ -e "$dest" ]]; then
  [[ -d "$dest/.git" || -f "$dest/.git" ]] || die "repos/$name already exists and is not a git repo"
  existing=$(git -C "$dest" remote get-url origin 2>/dev/null || true)
  [[ "$existing" == "$url" ]] || die "repos/$name already exists with different origin: $existing"
  die "repos/$name already exists"
fi

info "cloning $name"
git clone "$url" "$dest"
branch=$(repo_default_branch "$dest")

git -C "$dest" config workspace.defaultBranch "$branch"
git -C "$dest" config workspace.prefix "$prefix"

ensure_subtree_on_current_branch "$name"

ok "added repos/$name (origin: $url, default branch: $branch, prefix: $prefix)"
