#!/usr/bin/env bash
#MISE description="Register an upstream repo remote and add its subtree. Usage: add <name> <url> [prefix]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

name=${1:-}
url=${2:-}
prefix=${3:-}

[[ -z "$name" || -z "$url" || $# -gt 3 ]] && die "usage: mise run add <name> <url> [prefix]"
validate_name "repo" "$name"
require_workspace_root

root=$(workspace_root)
remote=$(repo_remote "$name")
[[ -n "$prefix" ]] || prefix="$name"
[[ "$prefix" != /* && "$prefix" != *..* && "$prefix" != "." ]] || die "invalid prefix: '$prefix'"

if git remote get-url "$remote" >/dev/null 2>&1; then
  existing=$(git remote get-url "$remote")
  [[ "$existing" == "$url" ]] || die "$name already exists with different origin: $existing"
  die "$name already exists"
fi

workspace_clean "$root" || die "workspace has uncommitted changes; commit or stash first"

branch=$(remote_default_branch "$url")
info "registering $name"
git remote add "$remote" "$url"
git config "remote.$remote.workspaceDefaultBranch" "$branch"
git config "remote.$remote.workspacePrefix" "$prefix"

ensure_subtree_on_current_branch "$name"

ok "added $name (origin: $url, default branch: $branch, prefix: $prefix)"
