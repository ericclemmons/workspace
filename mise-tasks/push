#!/usr/bin/env bash
#MISE description="Push touched subtrees to upstreams. Run from a worktree."
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

for arg in "$@"; do
  case "$arg" in
    *) die "unknown flag: $arg" ;;
  esac
done

require_worktree

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD"
[[ "$branch" != "main" ]] || die "on main — switch to a task branch first"

git diff --quiet && git diff --cached --quiet \
  || die "uncommitted changes — commit first"

base=$(git merge-base HEAD main) || die "couldn't find merge base with main"

# Detect touched subtrees so we only push changed upstreams.
touched=()
while IFS= read -r name; do
  touched+=("$name")
done < <(
  git diff --name-only "$base" HEAD \
    | awk -F/ '$1=="repos" && NF>1 {print $2}' | sort -u
)

[[ ${#touched[@]} -gt 0 ]] || { warn "no changes under repos/ — nothing to push"; exit 0; }

info "branch: $branch"
info "touched: ${touched[*]}"

for name in "${touched[@]}"; do
  git remote get-url "$name" >/dev/null 2>&1 \
    || die "no remote for subtree '$name' — add with: mise run add $name <url>"
  info "pushing repos/$name → $name:$branch"
  git subtree push --prefix="repos/$name" "$name" "$branch" \
    || die "push failed for $name — likely upstream moved. Try: mise run pull $name, then rebase, then re-push"
  ok "pushed $name"
done

ok "pushed all branches"
