#!/usr/bin/env bash
#MISE description="Push changed repo prefixes from a task worktree. Usage: push [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_task_root
root=$(workspace_root)
task=$(task_root)
branch=$(task_name)
current=$(git -C "$task" symbolic-ref --short HEAD 2>/dev/null || true)
[[ "$current" == "$branch" ]] || die "workspace worktree is on branch '$current', expected '$branch'"
workspace_clean "$task" || die ".worktrees/$branch has uncommitted changes; commit before push"

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
  repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_task_repos)
fi

[[ ${#repos[@]} -gt 0 ]] || die "no repo prefixes found in .worktrees/$branch"

tmp=$(mktemp -d)
worktrees=()
cleanup() {
  local work
  for work in "${worktrees[@]}"; do
    git -C "$task" worktree remove "$work" >/dev/null 2>&1 || rm -rf "$work"
  done
  rm -rf "$tmp"
}
trap cleanup EXIT

commit_author_env() {
  local commit=$1
  GIT_AUTHOR_NAME=$(git -C "$task" log -1 --format=%an "$commit")
  GIT_AUTHOR_EMAIL=$(git -C "$task" log -1 --format=%ae "$commit")
  GIT_AUTHOR_DATE=$(git -C "$task" log -1 --format=%aI "$commit")
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE
}

push_repo_branch() {
  local repo=$1 remote=$2 prefix=$3 default work commit patch message
  default=$(repo_default_branch "$repo")
  work="$tmp/$repo"

  git -C "$task" fetch "$remote" "$default"
  git -C "$task" worktree add --detach "$work" "$remote/$default" >/dev/null
  worktrees+=("$work")

  while IFS= read -r commit; do
    patch=$(git -C "$task" diff --binary --relative="$prefix" "$commit^" "$commit" -- "$prefix")
    [[ -n "$patch" ]] || continue

    if ! printf '%s\n' "$patch" | git -C "$work" apply --index --binary; then
      die "failed to apply $repo changes from workspace commit $commit"
    fi

    if git -C "$work" diff --cached --quiet; then
      continue
    fi

    message=$(git -C "$task" log -1 --format=%B "$commit")
    commit_author_env "$commit"
    git -C "$work" commit -q -m "$message"
  done < <(git -C "$task" rev-list --reverse main..HEAD -- "$prefix")

  git -C "$work" push "$remote" "+HEAD:refs/heads/$branch"
}

pushed=0
for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"

  prefix=$(repo_prefix "$repo")
  [[ -e "$task/$prefix" ]] || die ".worktrees/$branch is missing prefix $prefix for $repo"

  if git -C "$task" diff --quiet main..HEAD -- "$prefix"; then
    info "skipping $repo — no changes under $prefix"
    continue
  fi

  remote=$(cd "$task" && ensure_workspace_remote "$repo")
  info "pushing $repo ($branch) from $prefix"
  push_repo_branch "$repo" "$remote" "$prefix"

  pushed=$((pushed + 1))
  ok "pushed $repo"
done

[[ $pushed -gt 0 ]] && ok "pushed $pushed repo(s)" || warn "nothing to push"
