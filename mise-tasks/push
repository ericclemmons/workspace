#!/usr/bin/env bash
#MISE description="Push changed repos from a task worktree. Usage: push [repo...]"
source "${MISE_TASK_DIR:-$(dirname "$0")}/_lib"

require_task_root
root=$(workspace_root)
task=$(task_root)
branch=$(task_name)

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
  repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_task_repos)
fi

[[ ${#repos[@]} -gt 0 ]] || die "no repo worktrees found in worktrees/$branch"

pushed=0
for repo in "${repos[@]}"; do
  validate_name "repo" "$repo"
  wt="$task/$repo"
  [[ -d "$wt/.git" || -f "$wt/.git" ]] || die "worktrees/$branch/$repo is not a git repo"
  current=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || true)
  [[ "$current" == "$branch" ]] || die "$repo is on branch '$current', expected '$branch'"
  repo_clean "$wt" || die "$repo has uncommitted changes; commit before push"

  upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [[ -n "$upstream" && "${upstream#*/}" == "$branch" ]]; then
    ahead=$(git -C "$wt" rev-list --count "$upstream..HEAD")
    if [[ "$ahead" == "0" ]]; then
      info "skipping $repo — no commits ahead of $upstream"
      continue
    fi
    info "pushing $repo ($branch → $upstream)"
    git -C "$wt" push
  else
    base="$root/repos/$repo"
    default=$(repo_default_branch "$base")
    if git -C "$wt" merge-base --is-ancestor HEAD "origin/$default" 2>/dev/null; then
      info "skipping $repo — no commits ahead of origin/$default"
      continue
    fi
    info "pushing $repo ($branch → origin/$branch)"
    git -C "$wt" push -u origin "$branch"
  fi
  pushed=$((pushed + 1))
  ok "pushed $repo"
done

[[ $pushed -gt 0 ]] && ok "pushed $pushed repo(s)" || warn "nothing to push"
