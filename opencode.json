{
  "$schema": "https://opencode.ai/config.json",
  "hooks": {
    "tool.execute.before": {
      "edit": { "command": [".githooks/agent-guard-edit.sh"] },
      "write": { "command": [".githooks/agent-guard-edit.sh"] },
      "bash": { "command": [".githooks/agent-guard-bash.sh"] }
    },
    "session.user_message": {
      "command": [".githooks/agent-guard-context.sh"]
    }
  }
}
